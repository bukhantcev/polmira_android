FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends --fix-missing \
        ca-certificates \
        curl \
        gnupg \
        dbus-x11 \
        fonts-dejavu \
        gnome-keyring \
        libasound2t64 \
        libegl1 \
        libglib2.0-bin \
        libnss3 \
        libpulse0 \
        libxcb-shape0 \
        novnc \
        openbox \
        pcmanfm \
        python3 \
        python3-dbus \
        python3-gi \
        websockify \
        wget \
        libnotify-bin \
        xdotool \
        x11vnc \
        xdg-utils \
        xvfb \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.max.ru/linux/deb/public.asc | gpg --dearmor -o /etc/apt/keyrings/max.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/max.gpg] https://download.max.ru/linux/deb stable main" > /etc/apt/sources.list.d/max.list \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends --fix-missing max \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash polmira \
    && mkdir -p /home/polmira/Desktop /home/polmira/Downloads /home/polmira/.config/openbox /var/log/polmira \
    && cp /usr/share/applications/max.desktop /home/polmira/Desktop/MAX.desktop \
    && chmod +x /home/polmira/Desktop/MAX.desktop \
    && chown -R polmira:polmira /home/polmira

COPY max-container/start-session.sh /usr/local/bin/polmira-start-session
COPY max-container/notification-daemon.py /usr/local/bin/polmira-notification-daemon
COPY max-container/file-watcher.py /usr/local/bin/polmira-file-watcher
COPY max-container/novnc/ui.js /usr/share/novnc/app/ui.js
COPY max-container/novnc/base.css /usr/share/novnc/app/styles/base.css
RUN chmod +x /usr/local/bin/polmira-start-session /usr/local/bin/polmira-notification-daemon /usr/local/bin/polmira-file-watcher

EXPOSE 6080

CMD ["/usr/local/bin/polmira-start-session"]
